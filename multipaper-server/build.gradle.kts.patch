+val applyMultiPaperChunkHolderBasePatch = tasks.register("applyMultiPaperChunkHolderBasePatch") {
+    dependsOn("applyMinecraftPatches")
+    doLast {
+        val patchFile = rootProject.file("multipaper-server/minecraft-patches/sources/0004-MultiPaper-modern-port-NewChunkHolder.patch")
+        val sourceRoot = "multipaper-server/src/minecraft/java"
+        val check = services.execOperations.exec {
+            workingDir(rootProject.projectDir)
+            commandLine("git", "apply", "--ignore-space-change", "--check", "--directory=$sourceRoot", patchFile.absolutePath)
+            isIgnoreExitValue = true
+        }
+        if (check.exitValue == 0) {
+            services.execOperations.exec {
+                workingDir(rootProject.projectDir)
+                commandLine("git", "apply", "--ignore-space-change", "--whitespace=nowarn", "--directory=$sourceRoot", patchFile.absolutePath)
+            }
+        } else {
+            val alreadyApplied = services.execOperations.exec {
+                workingDir(rootProject.projectDir)
+                commandLine("git", "apply", "--ignore-space-change", "--reverse", "--check", "--directory=$sourceRoot", patchFile.absolutePath)
+                isIgnoreExitValue = true
+            }
+            if (alreadyApplied.exitValue != 0) {
+                throw GradleException("Could not apply MultiPaper NewChunkHolder base patch to regenerated NewChunkHolder.java")
+            }
+        }
+    }
+}
