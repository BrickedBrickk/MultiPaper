+                    // can unload immediately
+                    this.removeChunkHolder(chunkHolder);
+                    return true;
+                }
+            } finally {
+                this.taskScheduler.schedulingLockArea.unlock(schedulingLock);
+            }
+        } finally {
+            this.ticketLockArea.unlock(ticketLock);
+        }
+
